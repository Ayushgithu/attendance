# Supabase transaction pooler (port 6543) - used by the app at runtime
DATABASE_URL=
# Supabase session pooler (port 5432) - required by prisma.config.ts for migrate, db seed
DIRECT_URL=
NEXTAUTH_SECRET=         # long random string (openssl rand -base64 32)
NEXTAUTH_URL=            # this app's own domain, e.g. https://student.example.com
NEXT_PUBLIC_PORT=        # same as NEXTAUTH_URL (used by pages/client to call /api)
NEXT_PUBLIC_LANDING_URL= # the shared landing site, e.g. https://example.com (sign-out and / go here)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudinary (face photos are stored here as private/authenticated images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ...or a single variable instead of the three above:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Email (optional; without these, emails are skipped)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Attendance via Face <no-reply@yourdomain.com>
# Students below this % get warnings (default 75)
ATTENDANCE_MIN_PERCENT=75
